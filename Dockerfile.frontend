# --- build stage ---
FROM node:22-alpine AS builder
WORKDIR /app

# Если есть приватный реестр, раскомментируй следующую строку и передавай ARG при сборке:
# ARG NPM_TOKEN
# RUN if [ -n "$NPM_TOKEN" ]; then echo "//registry.npmjs.org/:_authToken=${NPM_TOKEN}" > .npmrc; fi

# tools для node-gyp (на случай нативных модулей)
RUN apk add --no-cache python3 make g++ git

# Копируем только манифесты, чтобы кешировать зависимости
COPY package.json package-lock.json* ./

# Устойчивый шаг: ci если есть lock, иначе install
# + кэш npm (buildkit), можно убрать если не используешь DOCKER_BUILDKIT=1
# syntax=docker/dockerfile:1.6
# (если не используешь buildkit, просто убери строку с --mount)
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then \
      echo "Using npm ci"; npm ci --legacy-peer-deps; \
    else \
      echo "No package-lock.json, using npm install"; npm install --legacy-peer-deps; \
    fi

# Копируем исходники и билдим
COPY . .
RUN npm run build

# --- runtime stage ---
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80